# Base de données Neon (Postgres) - Récupérez la chaîne de connexion dans
# votre projet Neon : Dashboard > Connection Details > "Connection string"
DATABASE_URL="postgresql://user:password@ep-xxxx-xxxx.region.aws.neon.tech/dbname?sslmode=require"

# Sécurité JWT
JWT_SECRET="CHANGEZ_CE_SECRET_EN_PRODUCTION"

# Identifiants admin par défaut (premier démarrage)
ADMIN_PHONE="0000"
ADMIN_PASSWORD="admin_secure_password"

# URL(s) autorisée(s) en CORS pour accéder à l'API depuis un navigateur
# (liste séparée par des virgules si plusieurs). Le frontend web étant servi
# par ce même serveur, ce n'est utile que pour un site distinct (ex: un
# futur frontend séparé) — les clients non-navigateur (app Android) ne sont
# pas concernés par CORS. Laisser vide = aucun accès cross-origin autorisé.
APP_URL="http://localhost:3000"
